{
  "name": "@grandimam/pi-workspace",
  "version": "0.2.0",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "description": "A searchable workspace quick switcher and active-project footer for the Pi coding agent",
  "license": "MIT",
  "author": "Fauzan Baig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grandimam/pi-workspace.git"
  },
  "homepage": "https://github.com/grandimam/pi-workspace#readme",
  "bugs": { "url": "https://github.com/grandimam/pi-workspace/issues" },
  "keywords": ["pi-package", "pi-extension", "workspace", "terminal"],
  "files": ["src", "assets", "docs", "ROADMAP.md", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:tui": "python3 tests/tui-smoke.py",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
